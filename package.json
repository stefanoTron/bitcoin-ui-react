{
  "name": "bitcoin-ui-react",
  "version": "1.1.0",
  "description": "React components for Bitcoin amount display and input",
  "author": "Stefano Tron",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stefanoTron/bitcoin-ui-react.git"
  },
  "homepage": "https://github.com/stefanoTron/bitcoin-ui-react",
  "bugs": "https://github.com/stefanoTron/bitcoin-ui-react/issues",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "bitcoin",
    "ui",
    "react",
    "sats",
    "btc",
    "components"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./seed-phrase": {
      "types": "./dist/seed-phrase.d.ts",
      "import": "./dist/seed-phrase.mjs",
      "require": "./dist/seed-phrase.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "size:check": "size-limit --limit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "motion": "^12.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^9.0.0",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@storybook/addon-a11y": "^10.2.15",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/jest": "^29.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "size-limit": "^12.0.0",
    "storybook": "^10.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
